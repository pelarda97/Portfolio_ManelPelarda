---
import { profile } from '../../data/profile';

// ── About Me data ─────────────────────────────────────────────────────────
const bio       = profile.bio;
const stats     = profile.stats;
const interests = profile.interests;
---

<section
  id="sobre-mi"
  class="py-24 relative"
  aria-label="Sobre mí"
>
  <!-- Background accent -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-0 right-0 w-96 h-96 bg-neon-cyan/3 blur-[110px] rounded-full"></div>
  </div>

  <div class="section-container relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 items-center">

      <!-- Left: text block -->
      <div>
        <!-- Label -->
        <div class="flex items-center gap-3 mb-6 reveal">
          <div class="h-px w-10 bg-neon-cyan/60"></div>
          <span class="font-mono text-xs text-neon-cyan tracking-widest uppercase">Sobre mí</span>
        </div>

        <h2 class="section-title reveal" style="animation-delay: 0.05s">
          Hola, soy Manel.
        </h2>

        <!-- Bio -->
        <p class="bio-text text-slate-400 text-base leading-relaxed mb-8 reveal" style="animation-delay: 0.1s">
          {bio}
        </p>

        <!-- Interests -->
        <div class="interests-block reveal" style="animation-delay: 0.15s">
          <p class="text-xs font-mono text-slate-500 uppercase tracking-widest mb-3">Áreas de interés</p>
          <div class="interest-row flex flex-wrap gap-2">
            {interests.map(i => (
              <span class={`interest-chip text-xs font-mono font-semibold px-3 py-1.5 rounded-full border ${i.color}`}>
                {i.label}
              </span>
            ))}
          </div>
        </div>

        <!-- Contact links -->
        <div class="contact-row flex flex-wrap gap-3 mt-8 reveal" style="animation-delay: 0.2s">
          <a
            href="mailto:pelardeveloper@gmail.com"
            class="btn-ghost text-sm"
            aria-label="Enviar email a Manel"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Email
          </a>
          <a
            href="https://www.linkedin.com/in/manel-pelarda-011b263a4/"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost text-sm"
            aria-label="Perfil de LinkedIn de Manel"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
          <a
            href="https://github.com/pelarda97"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost text-sm"
            aria-label="Perfil de GitHub de Manel"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            GitHub
          </a>
        </div>
      </div>

      <!-- Right: stats grid -->
      <div class="reveal" style="animation-delay: 0.2s">
        <div class="stats-grid grid grid-cols-2 gap-4">
          {stats.map((s, i) => (
            <div
              class="glass-card p-6 text-center hover:border-neon-cyan/40 hover:shadow-card-hover transition-all duration-300"
              style={`animation-delay: ${0.25 + i * 0.05}s`}
            >
              <div class="font-display text-3xl font-bold text-neon-cyan mb-2 animate-glow">
                {s.value}
              </div>
              <div class="text-xs text-slate-500 leading-tight whitespace-pre-line">
                {s.label}
              </div>
            </div>
          ))}
        </div>

        <!-- Availability badge -->
        <div class="availability-badge mt-5 glass-card p-4 flex items-center gap-3">
          <span class="availability-dot relative flex h-3 w-3 shrink-0">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-neon-green opacity-75"></span>
            <span class="relative inline-flex rounded-full h-3 w-3 bg-neon-green"></span>
          </span>
          <div>
            <p class="text-sm font-medium text-white">{profile.availability.title}</p>
            <p class="text-xs text-slate-500">{profile.availability.subtitle}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('#sobre-mi .reveal').forEach(el => io.observe(el));
</script>
