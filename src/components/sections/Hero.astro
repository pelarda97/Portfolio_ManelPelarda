---
import { profile } from '../../data/profile';

// ── Data ────────────────────────────────────────────────────────────────────
const name        = profile.name;
const roleMain     = profile.roleMain;
const roleAlt      = profile.roleAlt;
const description  = profile.heroDescription;
const email        = profile.email;
---

<section
  id="inicio"
  class="relative min-h-screen flex flex-col justify-center overflow-hidden"
  aria-label="Presentación"
>
  <!-- Subtle radial glow behind content -->
  <div
    class="absolute inset-0 pointer-events-none"
    aria-hidden="true"
  >
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2
                w-[600px] h-[600px] rounded-full
                bg-neon-cyan/4 blur-[120px]"></div>
    <div class="absolute top-2/3 left-1/3
                w-[400px] h-[400px] rounded-full
                bg-neon-purple/4 blur-[100px]"></div>
  </div>

  <div class="section-container relative z-10 pt-28 pb-20">
    <div class="max-w-3xl">

      <!-- Eyebrow label -->
      <div class="flex items-center gap-3 mb-6 reveal">
        <div class="h-px w-10 bg-neon-cyan/60"></div>
        <span class="font-mono text-xs text-neon-cyan tracking-widest uppercase">
          Disponible para proyectos
        </span>
        <span class="inline-flex h-2 w-2 rounded-full bg-neon-green animate-pulse"></span>
      </div>

      <!-- Name -->
      <h1 class="reveal font-display text-5xl sm:text-6xl lg:text-7xl font-bold text-white leading-none mb-4"
          style="animation-delay: 0.1s">
        {name}
      </h1>

      <!-- Dual role -->
      <p class="hero-role reveal font-display text-xl sm:text-2xl font-semibold mb-6"
         style="animation-delay: 0.2s">
        <span class="text-neon-cyan">{roleMain}</span>
        <span class="text-slate-500 mx-3">&amp;</span>
        <span class="text-neon-purple">{roleAlt}</span>
      </p>

      <!-- Description -->
      <p class="hero-description reveal text-slate-400 text-base sm:text-lg leading-relaxed max-w-xl mb-10"
         style="animation-delay: 0.3s">
        {description}
      </p>

      <!-- CTA buttons -->
      <div class="cta-row reveal flex flex-wrap items-center gap-4 mb-16" style="animation-delay: 0.4s">
        <a href="#proyectos" class="btn-primary">
          Ver Proyectos
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="/cv" target="_blank" rel="noopener" class="btn-ghost">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Descargar CV
        </a>
      </div>

      <!-- Print-only contact bar (hidden on screen) -->
      <div class="print-contact-bar hidden">
        <span>Email: {email}</span>
        <span>LinkedIn: {profile.linkedinLabel}</span>
        <span>GitHub: {profile.githubLabel}</span>
      </div>
    </div>
  </div>

  <!-- Scroll down indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-slate-600 animate-float no-print"
       aria-hidden="true">
    <span class="text-xs font-mono tracking-widest uppercase">Scroll</span>
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>

<script>
  // Scroll-reveal: observe all .reveal elements and add .visible class
  const reveals = document.querySelectorAll('.reveal');
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.15 });

  reveals.forEach(el => io.observe(el));
</script>
