---
import { getCollection } from 'astro:content';

const allEducation = await getCollection('education');
const education = allEducation.sort((a, b) => a.data.order - b.data.order);

const typeLabel: Record<string, string> = {
  degree:      'Grado',
  course:      'Curso',
  certification: 'Certificación',
  bootcamp:    'Bootcamp',
  'self-taught': 'Autoaprendizaje',
};

const typeColor: Record<string, string> = {
  degree:        'text-neon-cyan  border-neon-cyan/30  bg-neon-cyan/10',
  bootcamp:      'text-neon-green border-neon-green/30 bg-neon-green/10',
  certification: 'text-neon-purple border-neon-purple/30 bg-neon-purple/10',
  course:        'text-amber-400   border-amber-400/30  bg-amber-400/10',
  'self-taught': 'text-slate-400   border-slate-600     bg-slate-800/40',
};
---

<section
  id="formacion"
  class="py-24 relative"
  aria-label="Formación y educación"
>
  <!-- Background accent -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-neon-purple/3 blur-[100px] rounded-full"></div>
  </div>

  <div class="section-container relative z-10">
    <!-- Header -->
    <div class="text-center mb-16 reveal">
      <p class="font-mono text-xs text-neon-purple tracking-widest uppercase mb-3">Trayectoria</p>
      <h2 class="section-title">Formación</h2>
      <p class="section-subtitle max-w-md mx-auto">
        Aprendizaje continuo en desarrollo web y videojuegos.
      </p>
    </div>

    <!-- Timeline -->
    <div class="relative max-w-2xl mx-auto">

      <!-- Vertical line -->
      <div
        class="timeline-line absolute left-5 top-0 bottom-0 w-px bg-gradient-to-b
               from-neon-cyan/30 via-neon-purple/20 to-transparent"
        aria-hidden="true"
      ></div>

      <ol class="space-y-0" role="list">
        {education.map((item, i) => (
          <li
            class="timeline-item relative pl-14 pb-12 reveal"
            style={`animation-delay: ${i * 0.1}s`}
          >
            <!-- Timeline dot -->
            <div
              class="timeline-dot absolute left-[14px] top-0 w-3 h-3 rounded-full
                     border-2 border-neon-cyan bg-dark-900 shadow-neon-cyan"
              aria-hidden="true"
            ></div>

            <!-- Card -->
            <article class="glass-card p-6 hover:border-neon-purple/40 hover:shadow-neon-purple/10 transition-all duration-300">
              <!-- Top row -->
              <div class="timeline-header flex flex-wrap items-start justify-between gap-2 mb-3">
                <div class="timeline-title-block">
                  <h3 class="font-display text-base font-bold text-white leading-snug mb-0.5">
                    {item.data.title}
                  </h3>
                  <p class="text-sm text-slate-400 font-medium">
                    {item.data.institution}
                    {item.data.location && (
                      <span class="text-slate-600 font-normal"> · {item.data.location}</span>
                    )}
                  </p>
                </div>
                <div class="timeline-meta flex flex-col items-end gap-1.5 shrink-0">
                  <span class={`timeline-type text-[10px] font-mono font-semibold px-2 py-0.5 rounded-full border ${typeColor[item.data.type]}`}>
                    {typeLabel[item.data.type]}
                  </span>
                  <span class="timeline-dates text-xs text-slate-500 font-mono">
                    {item.data.startDate}
                    {item.data.current
                      ? ' → Presente'
                      : item.data.endDate
                        ? ` → ${item.data.endDate}`
                        : ''}
                  </span>
                </div>
              </div>

              <!-- Description -->
              <p class="text-slate-400 text-sm leading-relaxed mb-4">
                {item.data.description}
              </p>

              <!-- Skills -->
              {item.data.skills && item.data.skills.length > 0 && (
                <div class="skill-row flex flex-wrap gap-1.5">
                  {item.data.skills.map(skill => (
                    <span class="skill-badge">{skill}</span>
                  ))}
                </div>
              )}

              <!-- Credential / link -->
              {(item.data.credential || item.data.link) && (
                <div class="timeline-footer-row flex items-center gap-3 mt-4 pt-3 border-t border-dark-600/40">
                  {item.data.credential && (
                    <span class="timeline-credential text-xs text-slate-500 font-mono flex items-center gap-1">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                      </svg>
                      {item.data.credential}
                    </span>
                  )}
                  {item.data.link && (
                    <a
                      href={item.data.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="timeline-link text-xs text-neon-cyan/70 hover:text-neon-cyan font-mono transition-colors ml-auto"
                    >
                      Ver programa →
                    </a>
                  )}
                </div>
              )}
            </article>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('visible');
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.1 });
  document.querySelectorAll('#formacion .reveal').forEach(el => io.observe(el));
</script>
